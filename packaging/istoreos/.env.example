# 留空表示尚未完成设备初始化。LuCI 部署时会读取当前设备的 Docker Root Dir，
# 创建 volumes/qidian/data，并把最终绝对路径写回此文件。
QIDIAN_DATA_PATH=

# 默认 HTTP 服务端口；使用设备 IP:9908 访问，并在网关防火墙/上级路由器转发 TCP 9908。
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=9908

# 首次安装自动允许创建一个所有者账号，完成后自动关闭注册；设为 true 才允许其他人注册。
REGISTRATION_ENABLED=false

# 仅在使用反向代理时启用；可信地址填写直接连接栖点容器的代理 IP。
TRUST_PROXY=false
TRUSTED_PROXY_IPS=

# 由 LuCI 按当前 .run 版本写入对应的 Docker Hub 成品镜像。
QIDIAN_IMAGE=
